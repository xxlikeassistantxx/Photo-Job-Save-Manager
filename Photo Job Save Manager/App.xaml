<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:Photo_Job_Save_Manager.Converters"
             x:Class="Photo_Job_Save_Manager.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Converters -->
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:NullOrEmptyToTemplateConverter x:Key="NullOrEmptyToTemplateConverter" />
            <converters:GreaterThanZeroToBoolConverter x:Key="GreaterThanZeroToBoolConverter" />
            <converters:ZeroOrNullToBoolConverter x:Key="ZeroOrNullToBoolConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
