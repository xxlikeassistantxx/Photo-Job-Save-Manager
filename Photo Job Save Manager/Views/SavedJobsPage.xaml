<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Photo_Job_Save_Manager.Views.SavedJobsPage"
             x:Name="RootPage"
             Title="Saved Jobs">
    <ContentPage.Content>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="Saved Jobs" FontSize="32" FontAttributes="Bold" />
            
            <!-- Search Bar for Job Names -->
            <SearchBar Placeholder="Search jobs by name..." 
                       Text="{Binding JobNameSearchText, Mode=TwoWay}"
                       TextChanged="OnJobNameSearchChanged"
                       SearchCommand="{Binding SearchCommand}"
                       BackgroundColor="LightGray"
                       Margin="0,0,0,10" />
            
            <!-- Job Type Picker -->
            <Picker Title="Select Job Type"
                    ItemsSource="{Binding JobTypes}"
                    ItemDisplayBinding="{Binding Name}"
                    SelectedItem="{Binding SelectedJobType, Mode=TwoWay}" />

            <!-- Date Range Filter -->
            <HorizontalStackLayout Spacing="10">
                <Label Text="Created Between:" VerticalOptions="Center" />
                <DatePicker Date="{Binding DateCreatedStart}" Format="yyyy-MM-dd" />
                <Label Text="and" VerticalOptions="Center" />
                <DatePicker Date="{Binding DateCreatedEnd}" Format="yyyy-MM-dd" />
            </HorizontalStackLayout>

            <!-- Dynamic Search Bars for each field -->
            <StackLayout BindableLayout.ItemsSource="{Binding FieldSearchTerms}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <StackLayout Orientation="Horizontal" Spacing="8">
                            <Label Text="{Binding FieldName}" WidthRequest="120" VerticalOptions="Center" />
                            <!-- Picker for dropdown fields -->
                            <Picker ItemsSource="{Binding AllowedValues}" SelectedItem="{Binding SearchText, Mode=TwoWay}" IsVisible="{Binding AllowedValues.Count, Converter={StaticResource GreaterThanZeroToBoolConverter}}" />
                            <!-- Entry for text fields -->
                            <Entry Placeholder="Search..." Text="{Binding SearchText, Mode=TwoWay}" TextChanged="OnSearchTextChanged" IsVisible="{Binding AllowedValues.Count, Converter={StaticResource ZeroOrNullToBoolConverter}}" />
                        </StackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </StackLayout>

            <!-- Filtered Jobs List -->
            <CollectionView ItemsSource="{Binding FilteredJobs}" SelectionMode="Single" SelectionChanged="OnJobSelected">
                <CollectionView.EmptyView>
                    <Label Text="No jobs saved yet." HorizontalOptions="Center" VerticalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,8,0,0" Padding="12" BorderColor="#DDD" CornerRadius="8">
                            <VerticalStackLayout>
                                <HorizontalStackLayout>
                                    <VerticalStackLayout HorizontalOptions="StartAndExpand">
                                        <!-- Show Job Name prominently -->
                                        <Label Text="{Binding JobName}" 
                                               FontAttributes="Bold" 
                                               FontSize="18" 
                                               TextColor="Blue" />
                                        <Label Text="{Binding JobTypeName}" 
                                               FontAttributes="Italic" 
                                               FontSize="14"
                                               TextColor="Gray" />
                                        <Label Text="{Binding CreatedAt, StringFormat='Created: {0:yyyy-MM-dd HH:mm}'}" FontSize="12" />
                                        <!-- Show other field values (excluding Name) -->
                                        <StackLayout>
                                            <Label Text="Details:" FontAttributes="Bold" FontSize="12" />
                                            <StackLayout BindableLayout.ItemsSource="{Binding OtherFieldData}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate>
                                                        <Label Text="{Binding Key}: {Binding Value}" FontSize="12" />
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </StackLayout>
                                        </StackLayout>
                                    </VerticalStackLayout>
                                    
                                    <!-- Action Buttons -->
                                    <VerticalStackLayout HorizontalOptions="End" Spacing="5">
                                        <Button Text="Edit" 
                                                Command="{Binding Source={x:Reference RootPage}, Path=EditJobCommand}" 
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="Blue"
                                                TextColor="White"
                                                CornerRadius="4"
                                                Padding="12,6"
                                                FontSize="12" />
                                        <Button Text="Upload to Cloud"
                                                Command="{Binding Source={x:Reference RootPage}, Path=UploadToCloudCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="Green"
                                                TextColor="White"
                                                CornerRadius="4"
                                                Padding="12,6"
                                                FontSize="12" />
                                        <Button Text="Remove"
                                                Command="{Binding Source={x:Reference RootPage}, Path=RemoveJobCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="Red"
                                                TextColor="White"
                                                CornerRadius="4"
                                                Padding="12,6"
                                                FontSize="12" />
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ContentPage.Content>
</ContentPage> 