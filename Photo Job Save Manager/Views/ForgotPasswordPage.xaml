<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Photo_Job_Save_Manager.Views.ForgotPasswordPage"
             Title="Forgot Password"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#1F1F1F}">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25">
            
            <!-- Header -->
            <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                <Label Text="Reset Password" 
                       Style="{StaticResource Headline}"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light=#512BD4, Dark=#A78BFA}" />
                <Label Text="Enter your email to receive a password reset link" 
                       Style="{StaticResource SubHeadline}"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
            </VerticalStackLayout>

            <!-- Form -->
            <VerticalStackLayout Spacing="20">
                
                <!-- Email Entry -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Email" 
                           Style="{StaticResource BodyStrong}"
                           TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" />
                    <Entry x:Name="EmailEntry"
                           Placeholder="Enter your email address"
                           Text="{Binding Email}"
                           Keyboard="Email"
                           ReturnType="Done"
                           Completed="OnEmailCompleted" />
                </VerticalStackLayout>

                <!-- Message Display -->
                <Frame IsVisible="{Binding IsMessageVisible}"
                       BackgroundColor="{Binding IsSuccessMessage, Converter={StaticResource BoolToColorConverter}}"
                       Padding="15"
                       CornerRadius="8"
                       Margin="0,10,0,0">
                    <Label Text="{Binding Message}"
                           TextColor="White"
                           HorizontalOptions="Center" />
                </Frame>

                <!-- Send Reset Button -->
                <Button Text="Send Reset Link"
                        Command="{Binding SendResetCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                        BackgroundColor="{AppThemeBinding Light=#512BD4, Dark=#A78BFA}"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="50"
                        FontAttributes="Bold" />

                <!-- Loading Indicator -->
                <ActivityIndicator IsVisible="{Binding IsBusy}"
                                  IsRunning="{Binding IsBusy}"
                                  Color="{AppThemeBinding Light=#512BD4, Dark=#A78BFA}"
                                  HorizontalOptions="Center" />

            </VerticalStackLayout>

            <!-- Back to Login -->
            <Button Text="Back to Login"
                    Command="{Binding BackToLoginCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=#512BD4, Dark=#A78BFA}"
                    FontAttributes="None"
                    HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage> 