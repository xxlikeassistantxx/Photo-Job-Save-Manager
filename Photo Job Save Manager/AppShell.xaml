<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Photo_Job_Save_Manager.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Photo_Job_Save_Manager"
    xmlns:views="clr-namespace:Photo_Job_Save_Manager.Views"
    Title="Photo Job Save Manager">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <ShellContent
        Title="Register"
        ContentTemplate="{DataTemplate views:RegisterPage}"
        Route="RegisterPage" />

    <ShellContent
        Title="Forgot Password"
        ContentTemplate="{DataTemplate views:ForgotPasswordPage}"
        Route="ForgotPasswordPage" />

    <TabBar Route="MainDashboardPage">
        <ShellContent Title="Job Types" ContentTemplate="{DataTemplate views:JobTypesPage}" />
        <ShellContent Title="Saved Jobs" ContentTemplate="{DataTemplate views:SavedJobsPage}" />
        <ShellContent Title="Cloud Storage" ContentTemplate="{DataTemplate views:CloudStoragePage}" Icon="tab_cloud.png" />
        <ShellContent Title="Account" ContentTemplate="{DataTemplate views:AccountPage}" />
        <ShellContent Title="Recycle Bin" ContentTemplate="{DataTemplate views:RecycleBinPage}" Icon="tab_trash.png" />
    </TabBar>

</Shell>
